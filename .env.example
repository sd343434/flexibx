# ─────────────────────────────────────────────────────────────
# Flexibx environment. Copy to `.env` and adjust. Never commit `.env`.
# Validated at boot by src/server/env.ts.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (docker compose defaults)
DATABASE_URL=postgresql://flexibx:flexibx@localhost:5432/flexibx?schema=public
# Dedicated database for integration tests (name MUST end with _test; tables are truncated)
TEST_DATABASE_URL=postgresql://flexibx:flexibx@localhost:5432/flexibx_test?schema=public

# Object storage — S3-compatible (SeaweedFS via `docker compose --profile storage up -d`)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=flexibx-dev
S3_ACCESS_KEY_ID=flexibx
S3_SECRET_ACCESS_KEY=flexibx-dev-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
# Storage backend: unset/`s3` = the S3 settings above (media library uploads need them).
# `test-memory` keeps uploads in the server process for automated end-to-end tests ONLY —
# objects vanish on restart; never use it for a real deployment.
STORAGE_DRIVER=
# Wasabi (S3-compatible) access keys — server environment ONLY, never the database or the
# admin form. Region, endpoint and bucket are set by a platform administrator in
# Admin → Storage. Leave empty until a Wasabi bucket is provisioned (docs/STORAGE_PROVIDERS.md).
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=

# ── Authentication (Better Auth) ──
# Required once auth is used. Generate with: openssl rand -base64 32
# Keep it out of the database and its backups. Rotating it signs everyone out
# (all existing session cookies become invalid).
AUTH_SECRET=
# Optional; defaults to APP_URL.
AUTH_URL=
# Trusted client-IP header set by YOUR reverse proxy (e.g. cf-connecting-ip, x-real-ip).
# Leave empty unless clients cannot set it themselves: empty = no header is trusted, and
# authentication rate limits fall back to one shared bucket per entry point (set this in
# production so limits are per client).
AUTH_IP_HEADER=
# Comma-separated IPs/CIDRs of your proxies (only with AUTH_IP_HEADER=x-forwarded-for).
AUTH_TRUSTED_PROXIES=
# Email verification for verified-only operations (accepting an invitation); sign-in and
# workspace creation never need it. Empty = required in production, not in development.
# "true"/"false" overrides it. (Production needs an email provider, a later phase.)
AUTH_REQUIRE_EMAIL_VERIFICATION=

# ── Mail ──
# Empty = environment default (logged in development, captured in tests, explicit
# failure in production). "test-outbox" writes rendered emails, including single-use
# links, to MAIL_OUTBOX_DIR (absolute path) for end-to-end tests ONLY — never in a real
# deployment.
MAIL_TRANSPORT=
MAIL_OUTBOX_DIR=

# ── Generated video retention ──
# Bearer secret (≥ 32 characters, e.g. `openssl rand -base64 48`) for
# POST /api/internal/video-retention, which a scheduler must call every 15 minutes.
# Empty = endpoint disabled (404). See docs/AI_VIDEO_RETENTION_POLICY.md.
VIDEO_RETENTION_CRON_SECRET=
# Generative video provider: "disabled" (default) or "fake" (deterministic local clips,
# no external call, no cost; refused in production). No real provider exists yet.
VIDEO_PROVIDER=
# "enabled" sends 48 h / 24 h expiry reminder emails (needs a real email provider).
# Empty/"disabled" (default) = in-app notices only.
VIDEO_EXPIRY_EMAILS=

# ── Advertising platforms (Meta: Facebook and Instagram ads) ──
# Empty = the integration shows "not configured" and calls nothing. Needs ENCRYPTION_KEY.
# Register {APP_URL}/api/integrations/meta/callback as a valid OAuth redirect URI.
META_APP_ID=
META_APP_SECRET=
# Graph / Marketing API version (default v26.0).
META_GRAPH_VERSION=
# Optional; defaults to {APP_URL}/api/integrations/meta/callback.
META_REDIRECT_URI=
# Business apps (Facebook Login for Business): the login configuration id from
# Facebook Login for Business → Configurations (User access token; permissions ads_read,
# ads_management, pages_show_list, pages_manage_ads). Set = the dialog uses config_id
# instead of a permission list.
META_CONFIG_ID=
# Snapchat Ads (Snap Marketing API OAuth app, created in Snapchat Ads Manager → Business
# Details). Empty = "not configured". Needs ENCRYPTION_KEY. Register
# {APP_URL}/api/integrations/snapchat/callback as the app's redirect URI.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# Optional; defaults to {APP_URL}/api/integrations/snapchat/callback.
SNAPCHAT_REDIRECT_URI=
# WhatsApp Business (same Meta app as above, with the WhatsApp product). Empty = "not
# configured". WHATSAPP_CONFIG_ID is the Embedded Signup configuration id (Facebook Login
# for Business → Configurations). Register {APP_URL}/api/integrations/whatsapp/callback
# as a valid OAuth redirect URI and {APP_URL}/api/integrations/whatsapp/webhook as the
# webhook callback URL with the verify token below (openssl rand -hex 24).
WHATSAPP_CONFIG_ID=
WHATSAPP_REDIRECT_URI=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# External writes, OFF by default. "true" only after validating with real platform
# credentials (sandbox/test accounts first). Even then, every campaign creation,
# activation and WhatsApp send needs a person's approval of the exact action.
ADS_EXECUTION_ENABLED=
WHATSAPP_SENDING_ENABLED=
# TikTok Ads (TikTok API for Business developer app, My Apps). Empty = "not configured".
# Needs ENCRYPTION_KEY. Register {APP_URL}/api/integrations/tiktok/callback as the app's
# redirect URL.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Optional; defaults to {APP_URL}/api/integrations/tiktok/callback.
TIKTOK_REDIRECT_URI=
# Optional; the app's "Advertiser authorization URL" from My Apps → Basic Information
# (default https://business-api.tiktok.com/portal/auth).
TIKTOK_AUTHORIZE_URL=
# AES-256-GCM key for advertising platform tokens (32 bytes, base64:
# openssl rand -base64 32). Rotating it makes stored tokens unreadable (reconnect).
ENCRYPTION_KEY=

# ── Reserved for later phases (optional now) ──
# Background jobs phase — Redis for BullMQ
REDIS_URL=
