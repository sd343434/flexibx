# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# generated
src/generated/
*.tsbuildinfo

# testing
coverage/
test-results/
playwright-report/
blob-report/

# env — never commit secrets
.env
.env.*
!.env.example
deploy/staging/staging.env
# Terraform working files and state (state lives in the owner's backend, never in Git)
deploy/staging/aws/.terraform/
deploy/staging/aws/*.tfstate
deploy/staging/aws/*.tfstate.*
deploy/staging/aws/terraform.tfvars

# misc
.DS_Store
*.log
.vercel

# database backups — never commit dumps (scripts/ops/db-backup.sh refuses the repo anyway)
*.dump
*.dump.sha256
*.counts.tsv
/backups*/
