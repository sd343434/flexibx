# Staging environment for deploy/staging/compose.yaml. Copy to deploy/staging/staging.env
# (git-ignored), fill in, keep it in the host's secret store — never in Git, an image or a
# log. Every value below is a placeholder. Staging uses its OWN database, bucket and
# secrets: never a production value. `docker compose run --rm check` validates all of it.

NODE_ENV=production
# Public HTTPS origin of staging (behind the host's TLS proxy).
APP_URL=https://staging.example.com
AUTH_URL=https://staging.example.com

# Private PostgreSQL 16 for staging only (direct connection, TLS). Roles: DATABASE_ROLES.md.
# DATABASE_URL is the RUNTIME login (app, worker, scheduler). The owner login of migrate,
# backup and the gate's db-verify is in staging-owner.env (staging-owner.env.example).
# Mark it once (ops image): scripts/ops/db-environment.sh mark staging --confirm-database <name>
# — `migrate` and the gate refuse an unmarked database.
DATABASE_URL=postgresql://flexibx_app:CHANGE_ME@staging-db.example.internal:5432/flexibx_staging?sslmode=require

# Generate: openssl rand -base64 32  (staging-only values; never reuse production ones)
AUTH_SECRET=
ENCRYPTION_KEY=
# Bearer secrets of the internal endpoints (openssl rand -hex 32)
AUTOMATION_CRON_SECRET=
VIDEO_RETENTION_CRON_SECRET=
OPS_STATUS_SECRET=

# Private S3-compatible bucket for staging only; a key limited to that bucket.
# Bucket rules (CORS for APP_URL, abort of incomplete uploads): STAGING_CREATOR_STUDIO.md § 2.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Test alert destination (HTTPS incoming webhook) watched by a person during the trial.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Mail: a real provider for the staging domain (verification and password emails).
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=Flexibx Staging <no-reply@staging.example.com>

# Creator Studio: no external AI processing until the owner's separate decision
# (CREATOR_STUDIO.md § 8). `simulated` is refused in production mode by design.
CREATOR_AI_PROVIDER=disabled
CREATOR_MAX_UPLOAD_MB=2000
LOG_LEVEL=info
