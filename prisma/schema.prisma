// Flexibx — database foundation (Phase 1)
//
// Conventions (see docs/ARCHITECTURE.md):
// - UUID primary keys generated by Postgres (gen_random_uuid()).
// - snake_case table/column names via @@map / @map.
// - Every workspace-owned table has a NOT NULL `workspace_id` FK with ON DELETE CASCADE,
//   and its indexes lead with `workspace_id`. Register such models in
//   src/server/db/tenant-guard.ts (TENANT_MODELS).
// - CHECK constraints and extensions live in raw SQL inside migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  BUSINESS
  AGENCY

  @@map("workspace_type")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  VIEWER
  CLIENT

  @@map("workspace_role")
}

enum Locale {
  ar
  en

  @@map("locale")
}

/// Platform user, also Better Auth's `user` model. `isPlatformAdmin` and `locale` are
/// never accepted from auth input (see src/server/auth/auth-config.ts).
model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String   @unique @db.Citext
  emailVerified    Boolean  @default(false) @map("email_verified")
  name             String
  image            String?
  locale           Locale   @default(ar)
  isPlatformAdmin  Boolean  @default(false) @map("is_platform_admin")
  /// Better Auth two-factor plugin: true once a TOTP authenticator is verified. Set and
  /// cleared only by the plugin (or the operator reset script), never by auth input.
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships               WorkspaceMember[]
  auditLogs                 AuditLog[]
  sessions                  Session[]
  twoFactor                 TwoFactor?
  twoFactorUsedCodes        TwoFactorUsedCode[]
  accounts                  Account[]
  invitationsCreated        WorkspaceInvitation[]
  contentCreated            ContentItem[]
  mediaUploaded             MediaAsset[]
  aiGenerations             AiGeneration[]
  generatedVideos           GeneratedVideo[]
  videoJobs                 VideoGenerationJob[]
  automationDelegate        AutomationPolicy[]     @relation("AutomationDelegate")
  agentRunsRequested        AgentRun[]
  agentTaskApprovals        AgentTaskApproval[]
  adOAuthStates             AdOAuthState[]
  adConnections             AdConnection[]
  adPlansCreated            AdPlan[]
  adSpendLimitsSet          AdSpendLimit[]
  whatsappContactsAdded     WhatsAppContact[]
  whatsappMessagesRequested WhatsAppMessage[]
  whatsappMessagesResolved  WhatsAppMessage[]      @relation("WhatsAppMessageResolvedBy")
  whatsappConsentActions    WhatsAppConsentEvent[] @relation("WhatsAppConsentActor")

  @@map("users")
}

/// Tenant root. An AGENCY workspace may own client workspaces through `parentWorkspaceId`.
///
/// Deletion is SOFT: the application sets `deletedAt` and must exclude soft-deleted
/// workspaces from every lookup. Hard deletes are blocked while audit history exists
/// (AuditLog -> Workspace is ON DELETE RESTRICT). A future, controlled purge job may
/// permanently delete a workspace's data (e.g. retention or data-erasure requests);
/// it is intentionally not implemented yet.
model Workspace {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String        @db.VarChar(120)
  slug              String        @unique @db.Citext
  type              WorkspaceType @default(BUSINESS)
  parentWorkspaceId String?       @map("parent_workspace_id") @db.Uuid
  defaultLocale     Locale        @default(ar) @map("default_locale")
  timezone          String        @default("Asia/Riyadh") @db.VarChar(64)
  /// Soft-deletion timestamp. NULL = active.
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent      Workspace?            @relation("WorkspaceClients", fields: [parentWorkspaceId], references: [id], onDelete: Restrict)
  clients     Workspace[]           @relation("WorkspaceClients")
  members     WorkspaceMember[]
  auditLogs   AuditLog[]
  invitations WorkspaceInvitation[]

  // Marketing Core (Phase 3). Changed only through their own guarded models.
  brand                 Brand?
  audiences             Audience[]
  marketingGoals        MarketingGoal[]
  contentPillars        ContentPillar[]
  campaigns             Campaign[]
  campaignGoals         CampaignGoal[]
  campaignPillars       CampaignPillar[]
  contentItems          ContentItem[]
  mediaAssets           MediaAsset[]
  contentItemAssets     ContentItemAsset[]
  aiGenerations         AiGeneration[]
  generatedVideos       GeneratedVideo[]
  generatedVideoFiles   GeneratedVideoFile[]
  videoJobs             VideoGenerationJob[]
  videoAttempts         VideoGenerationAttempt[]
  usageLedgerEntries    UsageLedgerEntry[]
  automationPolicy      AutomationPolicy?
  agentRuns             AgentRun[]
  agentTasks            AgentTask[]
  agentTaskApprovals    AgentTaskApproval[]
  adOAuthStates         AdOAuthState[]
  adConnections         AdConnection[]
  adAccounts            AdAccount[]
  adPlans               AdPlan[]
  whatsappSnapshots     WhatsAppSnapshot[]
  whatsappEvents        WhatsAppWebhookEvent[]
  adExecutionSteps      AdExecutionStep[]
  adSpendLimits         AdSpendLimit[]
  whatsappContacts      WhatsAppContact[]
  whatsappMessages      WhatsAppMessage[]
  whatsappConsentEvents WhatsAppConsentEvent[]
  creditAccount         CreditAccount?
  creditHolds           CreditHold[]
  creditLedgerEntries   CreditLedgerEntry[]
  creditRecharges       CreditRecharge[]
  socialChannels        SocialChannel[]
  socialAgents          SocialAgent[]
  socialInteractions    SocialInteraction[]
  socialReplies         SocialReply[]
  socialLessons         SocialLesson[]
  socialAutoReplyClaims SocialAutoReplyClaim[]
  socialPosts           SocialPost[]

  @@index([parentWorkspaceId])
  @@map("workspaces")
}

/// Tenant-owned: membership of a user in a workspace with a role.
model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
  @@map("workspace_members")
}

/// Tenant-owned: an invitation to join a workspace with a role. Only the SHA-256 hash
/// of the one-time token is stored; the plaintext exists once, in the link shown to the
/// inviter. Pending = not accepted, not revoked (expiry is checked by the application).
/// Raw SQL in the migration adds: one pending invitation per (workspace, email), no
/// OWNER invitations, hex token hash, and "accepted XOR revoked or neither".
model WorkspaceInvitation {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  email           String        @db.Citext
  role            WorkspaceRole
  tokenHash       String        @unique @map("token_hash") @db.Char(64)
  invitedByUserId String?       @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?     @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([invitedByUserId])
  @@map("workspace_invitations")
}

/// Append-only audit trail. `workspaceId` is null for platform-level events.
/// Workspace deletion must never erase audit history, hence ON DELETE RESTRICT.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ── Authentication (Better Auth). Global/system tables: never workspace-scoped and
// only accessed by the auth layer through the system client (see tenant-guard.ts). ──

/// Database session. `token` is Better Auth's raw session token; the cookie carries
/// `token.HMAC(token, AUTH_SECRET)`, so a database copy alone cannot forge a cookie.
/// Application code must never read this table directly (enforced by the tenant guard
/// and a static test).
model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  token         String    @unique
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  /// When this session passed a second factor (TOTP or backup code). Set only when the
  /// session is created by a successful two-factor verification; NULL otherwise. The
  /// platform-admin gate requires it (src/server/admin/platform-admin.ts).
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Credentials per provider. For email/password, `providerId = "credential"` and
/// `password` holds the scrypt hash. OAuth columns are reserved (OAuth is not enabled).
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived verification values (email verification, password reset).
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Better Auth two-factor plugin state, one row per user. `secret` (TOTP seed) and
/// `backupCodes` are encrypted by Better Auth with AUTH_SECRET; neither is ever returned
/// by an API. `verified` is false between enrollment start and the first valid code.
/// Global/system table (not workspace-owned).
model TwoFactor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String    @unique @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factors")
}

/// TOTP codes already used to sign in, so a code seen by someone else (shoulder, phishing
/// relay) cannot be replayed within its 30-second window ±1 step. One row per user and
/// code (SHA-256 of user id + code), kept a few minutes. Global/system table.
model TwoFactorUsedCode {
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, codeHash])
  @@index([expiresAt])
  @@map("two_factor_used_codes")
}

/// Better Auth's rate-limit counters (`rateLimit.storage: "database"`). Global/system
/// table, only the auth layer touches it. `key` is `<client ip or fallback>|<path>`;
/// Flexibx-defined buckets put an HMAC of the email or user id in the path, never the
/// raw value. `lastRequest` is a millisecond timestamp.
model RateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@index([lastRequest])
  @@map("rate_limits")
}

// ── Marketing Core (Phase 3) ──────────────────────────────────────────────────
// Every model below is workspace-owned: a NOT NULL workspace_id, registered in the
// tenant guard, and every relation between two of them is checked by a database
// trigger to stay inside one workspace (see the migration). Platform-independent:
// nothing here knows about a social network.

enum BrandLanguage {
  AR
  EN
  BILINGUAL

  @@map("brand_language")
}

enum BuyingIntent {
  LOW
  MEDIUM
  HIGH

  @@map("buying_intent")
}

enum MarketingGoalType {
  AWARENESS
  ENGAGEMENT
  LEADS
  SALES
  RETENTION
  TRAFFIC
  GROWTH
  OTHER

  @@map("marketing_goal_type")
}

enum MarketingGoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ARCHIVED

  @@map("marketing_goal_status")
}

enum ContentPillarStatus {
  ACTIVE
  ARCHIVED

  @@map("content_pillar_status")
}

enum CampaignStatus {
  DRAFT
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED

  @@map("campaign_status")
}

enum ContentType {
  POST
  REEL
  STORY
  VIDEO
  CAROUSEL
  ARTICLE
  EMAIL
  OTHER

  @@map("content_type")
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED

  @@map("content_status")
}

/// One brand profile per workspace: the source the future AI Brand Brain will read.
model Brand {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String        @unique @map("workspace_id") @db.Uuid
  name             String        @db.VarChar(120)
  description      String?       @db.VarChar(2000)
  website          String?       @db.VarChar(2048)
  industry         String?       @db.VarChar(120)
  market           String?       @db.VarChar(200)
  language         BrandLanguage @default(AR)
  mission          String?       @db.VarChar(2000)
  positioning      String?       @db.VarChar(2000)
  valueProposition String?       @map("value_proposition") @db.VarChar(2000)
  toneOfVoice      String?       @map("tone_of_voice") @db.VarChar(1000)
  personality      String?       @db.VarChar(1000)
  keywords         String[]      @default([])
  forbiddenWords   String[]      @default([]) @map("forbidden_words")
  ctaStyle         String?       @map("cta_style") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("brands")
}

/// A marketing audience profile (not a CRM contact list).
model Audience {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  name              String        @db.VarChar(120)
  description       String?       @db.VarChar(2000)
  /// Free-form descriptive attributes: [{ "label": "...", "value": "..." }] (validated).
  attributes        Json          @default("[]")
  painPoints        String[]      @default([]) @map("pain_points")
  needs             String[]      @default([])
  interests         String[]      @default([])
  buyingIntent      BuyingIntent? @map("buying_intent")
  objections        String[]      @default([])
  preferredChannels String[]      @default([]) @map("preferred_channels")
  notes             String?       @db.VarChar(4000)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentPillars ContentPillar[]
  campaigns      Campaign[]
  contentItems   ContentItem[]

  @@index([workspaceId, name])
  @@map("audiences")
}

model MarketingGoal {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  type        MarketingGoalType
  title       String              @db.VarChar(160)
  description String?             @db.VarChar(2000)
  kpi         String?             @db.VarChar(160)
  target      Decimal?            @db.Decimal(14, 2)
  startDate   DateTime?           @map("start_date") @db.Date
  endDate     DateTime?           @map("end_date") @db.Date
  status      MarketingGoalStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignGoals CampaignGoal[]
  contentItems  ContentItem[]

  @@index([workspaceId, status])
  @@map("marketing_goals")
}

model ContentPillar {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  name        String              @db.VarChar(120)
  description String?             @db.VarChar(2000)
  objective   String?             @db.VarChar(1000)
  audienceId  String?             @map("audience_id") @db.Uuid
  status      ContentPillarStatus @default(ACTIVE)
  /// Ordering inside the workspace (lower first).
  position    Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  audience        Audience?        @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  campaignPillars CampaignPillar[]
  contentItems    ContentItem[]

  @@index([workspaceId, status, position])
  @@index([audienceId])
  @@map("content_pillars")
}

model Campaign {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String         @map("workspace_id") @db.Uuid
  name              String         @db.VarChar(160)
  description       String?        @db.VarChar(2000)
  objective         String?        @db.VarChar(1000)
  startDate         DateTime?      @map("start_date") @db.Date
  endDate           DateTime?      @map("end_date") @db.Date
  status            CampaignStatus @default(DRAFT)
  audienceId        String?        @map("audience_id") @db.Uuid
  /// Planning metadata only (minor units + ISO 4217); no ad platform, no billing.
  budgetAmountMinor BigInt?        @map("budget_amount_minor")
  budgetCurrency    String?        @map("budget_currency") @db.Char(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  audience     Audience?        @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  goals        CampaignGoal[]
  pillars      CampaignPillar[]
  contentItems ContentItem[]

  @@index([workspaceId, status, startDate])
  @@index([audienceId])
  @@map("campaigns")
}

model CampaignGoal {
  workspaceId String   @map("workspace_id") @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  goalId      String   @map("goal_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  goal      MarketingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([campaignId, goalId])
  @@index([workspaceId])
  @@index([goalId])
  @@map("campaign_goals")
}

model CampaignPillar {
  workspaceId String   @map("workspace_id") @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  pillarId    String   @map("pillar_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pillar    ContentPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@id([campaignId, pillarId])
  @@index([workspaceId])
  @@index([pillarId])
  @@map("campaign_pillars")
}

/// A platform-independent piece of marketing content and its workflow state.
model ContentItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  title           String        @db.VarChar(200)
  body            String        @default("") @db.VarChar(10000)
  type            ContentType   @default(POST)
  status          ContentStatus @default(DRAFT)
  campaignId      String?       @map("campaign_id") @db.Uuid
  pillarId        String?       @map("pillar_id") @db.Uuid
  audienceId      String?       @map("audience_id") @db.Uuid
  goalId          String?       @map("goal_id") @db.Uuid
  /// Planned time while a draft; the committed time once SCHEDULED.
  scheduledAt     DateTime?     @map("scheduled_at") @db.Timestamptz(3)
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(3)
  notes           String?       @db.VarChar(4000)
  metadata        Json          @default("{}")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign    Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pillar      ContentPillar?     @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  audience    Audience?          @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  goal        MarketingGoal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdBy   User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  assets      ContentItemAsset[]
  /// AI suggestions generated for this draft (Phase 4).
  aiAssists   AiGeneration[]     @relation("AiGenerationTarget")
  /// AI suggestions that were used to create or change this item (Phase 4).
  aiApplied   AiGeneration[]     @relation("AiGenerationApplied")
  /// Publications of this item to the workspace's Facebook Pages.
  socialPosts SocialPost[]

  @@index([workspaceId, status, updatedAt(sort: Desc)])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([campaignId])
  @@index([pillarId])
  @@index([audienceId])
  @@index([goalId])
  @@index([createdByUserId])
  @@map("content_items")
}

/// An uploaded file. Bytes live in object storage under a server-generated key.
model MediaAsset {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String          @map("workspace_id") @db.Uuid
  /// Display name only (sanitized); never used for storage paths.
  filename         String          @db.VarChar(255)
  contentType      String          @map("content_type") @db.VarChar(100)
  sizeBytes        Int             @map("size_bytes")
  storageKey       String          @unique @map("storage_key") @db.VarChar(512)
  /// Where the object is stored (set once; see StorageProvider). No default: every
  /// writer must state the provider it wrote to (existing rows were backfilled).
  storageProvider  StorageProvider @map("storage_provider")
  width            Int?
  height           Int?
  altText          String?         @map("alt_text") @db.VarChar(500)
  metadata         Json            @default("{}")
  uploadedByUserId String?         @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User?              @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  contentLinks ContentItemAsset[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([uploadedByUserId])
  @@map("media_assets")
}

model ContentItemAsset {
  workspaceId   String   @map("workspace_id") @db.Uuid
  contentItemId String   @map("content_item_id") @db.Uuid
  mediaAssetId  String   @map("media_asset_id") @db.Uuid
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([contentItemId, mediaAssetId])
  @@index([workspaceId])
  @@index([mediaAssetId])
  @@map("content_item_assets")
}

// ── AI Marketing Engine (Phase 4) ────────────────────────────────────────────

enum AiOperation {
  IDEAS
  BRIEF
  COPY
  CONTENT_DRAFT
  CONTENT_REWRITE
  CONTENT_ALTERNATIVES
  CONTENT_HOOK
  CONTENT_CTA
  CONTENT_BRIEF
  /// Advertising campaign proposal (see src/server/ads/planner.ts); never applied as content.
  AD_PLAN
  /// A reply draft to a comment or message by an AI social agent (src/server/social).
  SOCIAL_REPLY
  /// An AI social agent reviewing its feedback and proposing better guidance.
  SOCIAL_LEARNING

  @@map("ai_operation")
}

enum AiGenerationStatus {
  /// Reserved under the daily cap; the provider call is in progress (or never finished).
  PENDING
  SUCCEEDED
  FAILED

  @@map("ai_generation_status")
}

/// One AI generation attempt: usage accounting and, when it succeeded, the validated
/// structured output a person may later use. Prompts are never stored.
model AiGeneration {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String             @map("workspace_id") @db.Uuid
  userId               String?            @map("user_id") @db.Uuid
  operation            AiOperation
  status               AiGenerationStatus @default(PENDING)
  provider             String             @db.VarChar(40)
  model                String?            @db.VarChar(100)
  language             Locale
  inputTokens          Int?               @map("input_tokens")
  outputTokens         Int?               @map("output_tokens")
  /// Estimated cost in millionths of a US dollar; null when it cannot be calculated.
  costMicros           BigInt?            @map("cost_micros")
  latencyMs            Int?               @map("latency_ms")
  errorCode            String?            @map("error_code") @db.VarChar(40)
  /// The draft this suggestion is for (content assistance only).
  contentItemId        String?            @map("content_item_id") @db.Uuid
  /// Validated output (SUCCEEDED only).
  output               Json?
  /// Server-side map of the short reference handles shown to the model (P1, C1) to ids.
  references           Json               @default("{}")
  appliedAt            DateTime?          @map("applied_at") @db.Timestamptz(3)
  appliedContentItemId String?            @map("applied_content_item_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  contentItem        ContentItem? @relation("AiGenerationTarget", fields: [contentItemId], references: [id], onDelete: SetNull)
  appliedContentItem ContentItem? @relation("AiGenerationApplied", fields: [appliedContentItemId], references: [id], onDelete: SetNull)
  adPlans            AdPlan[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, userId, createdAt(sort: Desc)])
  @@index([workspaceId, contentItemId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([contentItemId])
  @@index([appliedContentItemId])
  @@map("ai_generations")
}

// ── Generated video retention ──
// Successfully generated AI videos are kept for exactly 7 days (168 hours) from the
// server-side success timestamp; then every stored file (video, thumbnail, derivatives,
// temporary files) is deleted by the retention job. The row itself is kept as job/cost
// metadata under a separate retention period (docs/AI_VIDEO_RETENTION_POLICY.md).

enum GeneratedVideoStatus {
  /// Files are stored and downloadable until expires_at.
  AVAILABLE
  /// Expired; the retention job is deleting the files (retried with backoff).
  DELETING
  /// Every file is deleted; only metadata remains.
  DELETED
}

enum GeneratedVideoFileKind {
  VIDEO
  THUMBNAIL
  DERIVATIVE
  TEMPORARY
}

/// One successfully generated AI video and its job/cost metadata.
model GeneratedVideo {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String               @map("workspace_id") @db.Uuid
  /// Who requested the video; receives the expiry reminders.
  userId                String?              @map("user_id") @db.Uuid
  title                 String               @db.VarChar(200)
  provider              String               @db.VarChar(40)
  model                 String?              @db.VarChar(100)
  providerJobId         String?              @map("provider_job_id") @db.VarChar(200)
  durationSeconds       Int                  @map("duration_seconds")
  width                 Int
  height                Int
  /// Cost in millionths of a US dollar; null when unknown.
  costMicros            BigInt?              @map("cost_micros")
  status                GeneratedVideoStatus @default(AVAILABLE)
  /// Set by the database (now()) when the row is created; never changes.
  succeededAt           DateTime             @default(dbgenerated("statement_timestamp()")) @map("succeeded_at") @db.Timestamptz(3)
  /// Always succeeded_at + 168 hours (database trigger); never set by the application.
  expiresAt             DateTime             @default(dbgenerated("(now() + '168:00:00'::interval)")) @map("expires_at") @db.Timestamptz(3)
  reminder48hAt         DateTime?            @map("reminder_48h_at") @db.Timestamptz(3)
  reminder24hAt         DateTime?            @map("reminder_24h_at") @db.Timestamptz(3)
  deletionAttempts      Int                  @default(0) @map("deletion_attempts")
  nextDeletionAttemptAt DateTime?            @map("next_deletion_attempt_at") @db.Timestamptz(3)
  lastDeletionError     String?              @map("last_deletion_error") @db.VarChar(60)
  filesDeletedAt        DateTime?            @map("files_deleted_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  files     GeneratedVideoFile[]
  job       VideoGenerationJob?

  @@index([workspaceId, succeededAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([userId])
  @@map("generated_videos")
}

/// A stored object belonging to a generated video. The row outlives the object as a
/// tombstone (deleted_at) so deletion stays auditable and idempotent.
model GeneratedVideoFile {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String                 @map("workspace_id") @db.Uuid
  videoId         String                 @map("video_id") @db.Uuid
  kind            GeneratedVideoFileKind
  storageKey      String                 @unique @map("storage_key") @db.VarChar(300)
  /// Where the object is stored (set once; see StorageProvider). No default: every
  /// writer must state the provider it wrote to (existing rows were backfilled).
  storageProvider StorageProvider        @map("storage_provider")
  contentType     String                 @map("content_type") @db.VarChar(100)
  byteSize        Int                    @map("byte_size")
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  video     GeneratedVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([workspaceId, videoId])
  @@index([videoId])
  @@map("generated_video_files")
}

// ── Generative video core (Phase 4) ──────────────────────────────────────────────
// One requested clip (job) owns its provider submissions (attempts); its money moves
// only through the append-only usage ledger (RESERVE → CAPTURE → RELEASE).
// docs/AI_MARKETING_EMPLOYEE_ARCHITECTURE.md §4.2. Request, policy check and reservation
// happen in one transaction, so a job is stored from RESERVED on.

enum VideoJobState {
  /// Worst-case cost reserved; no attempt yet.
  RESERVED
  IN_PROGRESS
  /// A validated, stored clip waits for a person to accept or reject it.
  READY_FOR_REVIEW
  ACCEPTED
  REJECTED
  FAILED
  /// A per-job bound (attempts, wall time) was reached.
  LIMIT_REACHED
  /// A submission's outcome is unknown and could not be reconciled: the reservation is
  /// held and nothing is resubmitted until an operator resolves it.
  NEEDS_RECONCILIATION
  CANCELLED

  @@map("video_job_state")
}

enum VideoAttemptState {
  /// Written BEFORE the provider is called.
  INTENDED
  /// The provider accepted the submission (provider job id stored).
  SUBMITTED
  /// The provider reports an output; not yet stored.
  OUTPUT_READY
  /// Output downloaded, validated, stored and recorded.
  VALIDATED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  REFUSED_BY_PROVIDER
  TIMED_OUT
  OUTCOME_UNKNOWN
  CANCELLED

  @@map("video_attempt_state")
}

enum UsageLedgerKind {
  RESERVE
  CAPTURE
  RELEASE

  @@map("usage_ledger_kind")
}

/// One requested generative clip. The prompt is business content (not audited).
model VideoGenerationJob {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String        @map("workspace_id") @db.Uuid
  userId           String?       @map("user_id") @db.Uuid
  title            String        @db.VarChar(200)
  prompt           String        @db.VarChar(2000)
  durationSeconds  Int           @map("duration_seconds")
  /// "16:9" or "9:16".
  aspectRatio      String        @map("aspect_ratio") @db.VarChar(5)
  /// "720p" or "1080p".
  resolution       String        @db.VarChar(5)
  audio            Boolean
  /// DRAFT or STANDARD (PREMIUM needs an approval flow that does not exist yet).
  tier             String        @db.VarChar(16)
  state            VideoJobState @default(RESERVED)
  maxAttempts      Int           @default(2) @map("max_attempts")
  attemptCount     Int           @default(0) @map("attempt_count")
  provider         String        @db.VarChar(40)
  model            String        @db.VarChar(100)
  rateCardVersion  String        @map("rate_card_version") @db.VarChar(40)
  /// Millionths of a US dollar.
  reservedMicros   BigInt        @map("reserved_micros")
  capturedMicros   BigInt        @default(0) @map("captured_micros")
  releasedMicros   BigInt        @default(0) @map("released_micros")
  failureCode      String?       @map("failure_code") @db.VarChar(40)
  generatedVideoId String?       @unique @map("generated_video_id") @db.Uuid
  /// Wall-time bound: attempts still running after this instant time out.
  deadlineAt       DateTime      @map("deadline_at") @db.Timestamptz(3)
  /// The runner currently driving the job, and until when its claim holds.
  leaseToken       String?       @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime?     @map("lease_expires_at") @db.Timestamptz(3)
  finishedAt       DateTime?     @map("finished_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  generatedVideo GeneratedVideo?          @relation(fields: [generatedVideoId], references: [id], onDelete: SetNull)
  attempts       VideoGenerationAttempt[]
  ledgerEntries  UsageLedgerEntry[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, state, createdAt])
  @@index([state, updatedAt])
  @@index([userId])
  @@map("video_generation_jobs")
}

/// One provider submission of a job (each may be billed).
model VideoGenerationAttempt {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String            @map("workspace_id") @db.Uuid
  jobId          String            @map("job_id") @db.Uuid
  attemptNo      Int               @map("attempt_no")
  /// hash(jobId, attemptNo): sent as the client reference; never reused.
  idempotencyKey String            @map("idempotency_key") @db.VarChar(64)
  state          VideoAttemptState @default(INTENDED)
  provider       String            @db.VarChar(40)
  model          String            @db.VarChar(100)
  providerJobId  String?           @map("provider_job_id") @db.VarChar(200)
  failureCode    String?           @map("failure_code") @db.VarChar(40)
  billedSeconds  Int?              @map("billed_seconds")
  costMicros     BigInt?           @map("cost_micros")
  /// True when the cost is our estimate (the provider reported no billed units).
  costEstimated  Boolean           @default(false) @map("cost_estimated")
  outputSha256   String?           @map("output_sha256") @db.Char(64)
  outputBytes    Int?              @map("output_bytes")
  submittedAt    DateTime?         @map("submitted_at") @db.Timestamptz(3)
  finishedAt     DateTime?         @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job       VideoGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNo])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, jobId])
  @@index([provider, providerJobId])
  @@map("video_generation_attempts")
}

/// Append-only money movements. Committed spend of a period = RESERVE − RELEASE;
/// CAPTURE records the part of a reservation actually charged.
model UsageLedgerEntry {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  jobId           String          @map("job_id") @db.Uuid
  /// e.g. VIDEO_GENERATIVE.
  category        String          @db.VarChar(40)
  /// The UTC day of the job's reservation (all its entries count against that day).
  period          DateTime        @db.Date
  kind            UsageLedgerKind
  amountMicros    BigInt          @map("amount_micros")
  estimated       Boolean         @default(false)
  rateCardVersion String          @map("rate_card_version") @db.VarChar(40)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job       VideoGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([workspaceId, period, category])
  @@index([jobId])
  @@map("usage_ledger_entries")
}

// ── Orchestration core (AI Marketing Manager) ─────────────────────────────────────
// Persistent, workspace-scoped runs of a workflow, made of tasks with dependencies,
// retries, timeouts and leases. Every run executes under the workspace's automation
// policy (emergency stop, cadence, what may happen without a person) and with the
// authority of the member who granted it, re-checked before every task.
// docs/AI_MARKETING_EMPLOYEE_ARCHITECTURE.md §2.

enum AutomationCadence {
  OFF
  DAILY
  WEEKLY

  @@map("automation_cadence")
}

enum AgentRunTrigger {
  MANUAL
  SCHEDULE

  @@map("agent_run_trigger")
}

enum AgentRunState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  /// Stopped on something a person must decide or fix (approval, lost access).
  NEEDS_ATTENTION

  @@map("agent_run_state")
}

enum AgentTaskState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  /// Not needed (a policy or the data made it unnecessary).
  SKIPPED
  CANCELLED
  /// Consequential: waits for a person (no policy grants it).
  NEEDS_APPROVAL

  @@map("agent_task_state")
}

/// One per workspace. Defaults are conservative: nothing runs on a schedule and nothing
/// is drafted until an administrator turns it on.
model AutomationPolicy {
  workspaceId     String            @id @map("workspace_id") @db.Uuid
  /// Scheduled autonomy on/off.
  enabled         Boolean           @default(false)
  /// Emergency stop: no task starts while set (manual and scheduled runs alike).
  paused          Boolean           @default(false)
  pausedAt        DateTime?         @map("paused_at") @db.Timestamptz(3)
  /// The member whose authority automation uses (who last enabled it); re-checked per task.
  delegateUserId  String?           @map("delegate_user_id") @db.Uuid
  planningCadence AutomationCadence @default(OFF) @map("planning_cadence")
  nextPlanningAt  DateTime?         @map("next_planning_at") @db.Timestamptz(3)
  /// May the manager create content drafts on its own? (Never publishes.)
  allowDrafts     Boolean           @default(false) @map("allow_drafts")
  maxDraftsPerRun Int               @default(3) @map("max_drafts_per_run")
  version         Int               @default(0)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  delegate  User?     @relation("AutomationDelegate", fields: [delegateUserId], references: [id], onDelete: SetNull)

  @@index([enabled, paused, nextPlanningAt])
  @@index([delegateUserId])
  @@map("automation_policies")
}

/// One execution of a workflow (e.g. content planning) in a workspace.
model AgentRun {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  workflow          String          @db.VarChar(40)
  trigger           AgentRunTrigger
  state             AgentRunState   @default(PENDING)
  requestedByUserId String?         @map("requested_by_user_id") @db.Uuid
  /// Unique per workspace: a schedule slot or a manual request runs once.
  idempotencyKey    String          @map("idempotency_key") @db.VarChar(120)
  /// The report of a finished run (counts and ids; no generated text).
  summary           Json?
  failureCode       String?         @map("failure_code") @db.VarChar(60)
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?       @map("finished_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy      User?               @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  tasks            AgentTask[]
  approvals        AgentTaskApproval[]
  adPlans          AdPlan[]
  adActivations    AdPlan[]            @relation("AdPlanActivation")
  whatsappMessages WhatsAppMessage[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([state, updatedAt])
  @@index([requestedByUserId])
  @@map("agent_runs")
}

/// One step of a run. Starts when every task in `dependsOn` succeeded or was skipped.
model AgentTask {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String         @map("workspace_id") @db.Uuid
  runId              String         @map("run_id") @db.Uuid
  key                String         @db.VarChar(40)
  handler            String         @db.VarChar(60)
  /// INTERNAL, EXTERNAL or SPEND (only INTERNAL can run without a person today).
  risk               String         @db.VarChar(20)
  dependsOn          String[]       @default([]) @map("depends_on")
  state              AgentTaskState @default(PENDING)
  attempts           Int            @default(0)
  maxAttempts        Int            @map("max_attempts")
  timeoutMs          Int            @map("timeout_ms")
  /// Not before this instant (retry backoff).
  runAfter           DateTime       @default(now()) @map("run_after") @db.Timestamptz(3)
  leaseToken         String?        @map("lease_token") @db.Uuid
  leaseExpiresAt     DateTime?      @map("lease_expires_at") @db.Timestamptz(3)
  output             Json?
  failureCode        String?        @map("failure_code") @db.VarChar(60)
  startedAt          DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime?      @map("finished_at") @db.Timestamptz(3)
  /// Approval requests made for this task so far (EXTERNAL/SPEND only; 0 = never asked).
  approvalRound      Int            @default(0) @map("approval_round")
  /// The action awaiting (or last given) approval: a deterministic description built by
  /// the task's `describe`, and its SHA-256 over canonical JSON.
  approvalRequest    Json?          @map("approval_request")
  approvalHash       String?        @map("approval_hash") @db.VarChar(64)
  /// A one-time grant: set by an APPROVED decision, cleared when the task is claimed
  /// (or cancelled). Only ever set while the task is PENDING.
  approvedDecisionId String?        @unique @map("approved_decision_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run              AgentRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  approvedDecision AgentTaskApproval?  @relation("ApprovedDecision", fields: [approvedDecisionId], references: [id], onDelete: SetNull)
  approvals        AgentTaskApproval[] @relation("TaskApprovals")

  @@unique([runId, key])
  @@index([workspaceId, runId])
  @@index([state, runAfter])
  @@index([state, leaseExpiresAt])
  @@map("agent_tasks")
}

enum AgentApprovalDecision {
  APPROVED
  REJECTED

  @@map("agent_approval_decision")
}

/// A person's decision on one approval request of an EXTERNAL or SPEND task. Immutable
/// (a trigger refuses updates other than the decider's account being deleted; the tenant
/// guard refuses deletes; workspace deletion still cascades). One decision per request
/// round. The snapshot is the exact action that was decided on.
model AgentTaskApproval {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String                @map("workspace_id") @db.Uuid
  runId           String                @map("run_id") @db.Uuid
  taskId          String                @map("task_id") @db.Uuid
  round           Int
  decision        AgentApprovalDecision
  decidedByUserId String?               @map("decided_by_user_id") @db.Uuid
  note            String?               @db.VarChar(500)
  /// INTERNAL never needs approval: EXTERNAL or SPEND.
  risk            String                @db.VarChar(20)
  snapshot        Json
  snapshotHash    String                @map("snapshot_hash") @db.VarChar(64)
  /// SPEND only: the amount approved, in minor units of `currency`.
  amountMinor     BigInt?               @map("amount_minor")
  currency        String?               @db.Char(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run       AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  task      AgentTask  @relation("TaskApprovals", fields: [taskId], references: [id], onDelete: Cascade)
  decidedBy User?      @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  grantedTo AgentTask? @relation("ApprovedDecision")

  @@unique([taskId, round])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([runId])
  @@index([decidedByUserId])
  @@map("agent_task_approvals")
}

// ── Object storage providers (platform admin) ─────────────────────────────────────

/// Where a stored object lives. Recorded on every object row and never changed in place:
/// reads and deletes go to the provider the object was written to.
/// - LEGACY_S3: the S3-compatible store configured by the S3_* environment variables —
///   every object stored before provider tracking existed (never assumed to be Wasabi).
/// - WASABI: the Wasabi account configured in the platform admin (non-secret settings
///   below; access keys only from the WASABI_* environment variables).
enum StorageProvider {
  LEGACY_S3
  WASABI
}

/// Platform-wide object-storage settings: a single row (id = 1), edited by platform
/// administrators only. Non-secret values only — access keys are never stored here.
/// `writeProvider` decides where NEW objects are written; existing objects keep their own
/// recorded provider. Changing it never moves or copies data.
model PlatformStorageSettings {
  id             Int             @id @default(1)
  writeProvider  StorageProvider @default(LEGACY_S3) @map("write_provider")
  wasabiRegion   String?         @map("wasabi_region") @db.VarChar(32)
  wasabiEndpoint String?         @map("wasabi_endpoint") @db.VarChar(255)
  wasabiBucket   String?         @map("wasabi_bucket") @db.VarChar(63)
  /// Incremented by every change; a change decided on an older version is refused.
  version        Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_storage_settings")
}

// ── Advertising platforms (Meta first; Snapchat, TikTok, WhatsApp later) ──────────
//
// One connection per workspace and platform, made through the platform's official OAuth
// flow by an administrator. The access token is stored only as an AES-256-GCM envelope
// bound to its workspace and platform (src/server/ads/token-vault.ts) and is never sent
// to a browser, logged or audited. Platform-specific shapes stop at the adapter
// (src/server/ads/adapters/*): everything stored here is the unified model.

enum AdPlatform {
  META
  SNAPCHAT
  TIKTOK
  WHATSAPP

  @@map("ad_platform")
}

enum AdConnectionStatus {
  ACTIVE
  /// The token expired or was invalidated by the platform; reconnect.
  EXPIRED
  /// Disconnected in Flexibx: the token was deleted.
  REVOKED
  /// The platform refused a required permission or the account check failed.
  ERROR

  @@map("ad_connection_status")
}

enum AdPlanStatus {
  DRAFT
  /// Sent to the approval workflow (agent run); edits are refused while submitted.
  SUBMITTED
  LAUNCHED
  FAILED
  DISCARDED

  @@map("ad_plan_status")
}

/// A pending OAuth authorization: single use, short-lived, bound to the person and the
/// workspace that started it. Only the SHA-256 of the state value is stored.
model AdOAuthState {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  platform    AdPlatform
  stateHash   String     @unique @map("state_hash") @db.VarChar(64)
  /// UI locale to return to after the platform redirects back.
  locale      String     @db.VarChar(5)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("ad_oauth_states")
}

model AdConnection {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  platform          AdPlatform
  status            AdConnectionStatus @default(ACTIVE)
  /// The platform user who granted access (id and display name only).
  externalUserId    String             @map("external_user_id") @db.VarChar(64)
  externalUserName  String?            @map("external_user_name") @db.VarChar(200)
  /// Permissions the platform reports as granted (e.g. ads_read).
  scopes            String[]           @default([])
  /// Encrypted access token envelope; null once disconnected.
  tokenCiphertext   String?            @map("token_ciphertext")
  tokenExpiresAt    DateTime?          @map("token_expires_at") @db.Timestamptz(3)
  connectedByUserId String?            @map("connected_by_user_id") @db.Uuid
  lastErrorCode     String?            @map("last_error_code") @db.VarChar(60)
  lastCheckedAt     DateTime?          @map("last_checked_at") @db.Timestamptz(3)
  version           Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy User?       @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  accounts    AdAccount[]

  @@unique([workspaceId, platform])
  @@index([connectedByUserId])
  @@map("ad_connections")
}

/// An advertising account the connection can see. `selected` accounts are the ones the
/// workspace works with; `snapshot` is the last read-only sync in the unified model.
model AdAccount {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String     @map("workspace_id") @db.Uuid
  connectionId   String     @map("connection_id") @db.Uuid
  platform       AdPlatform
  externalId     String     @map("external_id") @db.VarChar(64)
  name           String     @db.VarChar(200)
  currency       String     @db.Char(3)
  timeZone       String?    @map("time_zone") @db.VarChar(64)
  /// Unified account status (ACTIVE, DISABLED, UNSETTLED, PENDING, CLOSED, OTHER).
  externalStatus String     @map("external_status") @db.VarChar(20)
  selected       Boolean    @default(false)
  snapshot       Json?
  lastSyncedAt   DateTime?  @map("last_synced_at") @db.Timestamptz(3)
  syncErrorCode  String?    @map("sync_error_code") @db.VarChar(60)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection       AdConnection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  plans            AdPlan[]
  /// WhatsApp Business accounts only: the last read of numbers and templates.
  whatsappSnapshot WhatsAppSnapshot?
  whatsappEvents   WhatsAppWebhookEvent[]
  whatsappContacts WhatsAppContact[]
  whatsappMessages WhatsAppMessage[]

  @@unique([connectionId, externalId])
  @@index([workspaceId, platform])
  @@map("ad_accounts")
}

/// A proposed campaign for one ad account: the AI's suggestion, completed with the
/// budget and dates a person chose. Money and dates are deterministic columns, never
/// model output. Launching goes through the approval workflow (agent run).
model AdPlan {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String       @map("workspace_id") @db.Uuid
  accountId          String       @map("account_id") @db.Uuid
  platform           AdPlatform
  status             AdPlanStatus @default(DRAFT)
  name               String       @db.VarChar(200)
  /// The unified campaign spec (objective, audience, placements, creative).
  proposal           Json
  budgetTotalMinor   BigInt       @map("budget_total_minor")
  currency           String       @db.Char(3)
  startDate          DateTime     @map("start_date") @db.Date
  endDate            DateTime     @map("end_date") @db.Date
  aiGenerationId     String?      @map("ai_generation_id") @db.Uuid
  runId              String?      @map("run_id") @db.Uuid
  externalCampaignId String?      @map("external_campaign_id") @db.VarChar(64)
  failureCode        String?      @map("failure_code") @db.VarChar(60)
  createdByUserId    String?      @map("created_by_user_id") @db.Uuid
  /// The identity the ads publish as (Facebook Page, Snap profile, TikTok identity),
  /// resolved when the plan is submitted; part of the approved action.
  identityExternalId String?      @map("identity_external_id") @db.VarChar(64)
  /// The chosen identity's display name (shown for approval).
  identityName       String?      @map("identity_name") @db.VarChar(200)
  /// The identities the connection could advertise as when last listed: [{id, name}].
  identityOptions    Json?        @map("identity_options")
  identityCheckedAt  DateTime?    @map("identity_checked_at") @db.Timestamptz(3)
  /// Activation of the created (paused) campaign: null (not requested), REQUESTED,
  /// ACTIVE, UNCERTAIN (outcome unknown, reconcile first) or FAILED.
  activationStatus   String?      @map("activation_status") @db.VarChar(20)
  activationRunId    String?      @map("activation_run_id") @db.Uuid
  /// The campaign's delivery status as last read from the platform (unified).
  externalStatus     String?      @map("external_status") @db.VarChar(20)
  externalCheckedAt  DateTime?    @map("external_checked_at") @db.Timestamptz(3)
  version            Int          @default(0)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account       AdAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  aiGeneration  AiGeneration?     @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)
  run           AgentRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  activationRun AgentRun?         @relation("AdPlanActivation", fields: [activationRunId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  steps         AdExecutionStep[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([accountId])
  @@index([aiGenerationId])
  @@index([runId])
  @@index([createdByUserId])
  @@index([activationRunId])
  @@map("ad_plans")
}

/// The last read of a WhatsApp Business account (an AdAccount on platform WHATSAPP): its
/// business phone numbers (masked: last digits only) and message templates (name,
/// language, category, status). Never customer numbers or message contents.
model WhatsAppSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  accountId    String   @unique @map("account_id") @db.Uuid
  phoneNumbers Json     @map("phone_numbers")
  templates    Json
  fetchedAt    DateTime @map("fetched_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("whatsapp_snapshots")
}

/// One verified WhatsApp webhook event — an outgoing message's status or the fact that a
/// customer wrote — recorded once per workspace (`event_hash` deduplicates Meta's
/// retries and replays). Holds no phone numbers, message ids or contents: only the kind,
/// the status, the business number's id, an error code and when it happened.
model WhatsAppWebhookEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  eventHash     String   @map("event_hash") @db.Char(64)
  /// "status" (an outgoing message's sent/delivered/read/failed) or "message" (inbound).
  kind          String   @db.VarChar(20)
  status        String   @db.VarChar(20)
  phoneNumberId String   @map("phone_number_id") @db.VarChar(64)
  errorCode     Int?     @map("error_code")
  eventAt       DateTime @map("event_at") @db.Timestamptz(3)
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventHash])
  @@index([workspaceId, accountId, eventAt(sort: Desc)])
  @@index([accountId])
  @@map("whatsapp_webhook_events")
}

/// The execution ledger of a plan: one row per external object (media, campaign, ad set,
/// creative, ad) and for activation. Each write is recorded IN_FLIGHT before it is sent
/// and SUCCEEDED (with the external id), FAILED (definitely not done) or UNCERTAIN (may
/// have happened: reconciled by lookup before anything is written again).
model AdExecutionStep {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  step        String   @db.VarChar(20)
  status      String   @db.VarChar(20)
  externalId  String?  @map("external_id") @db.VarChar(64)
  errorCode   String?  @map("error_code") @db.VarChar(60)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      AdPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, step])
  @@index([workspaceId, planId])
  @@map("ad_execution_steps")
}

/// A workspace's advertising spending limits, per currency. No campaign is created or
/// activated without a limit for its currency: a plan's total budget and its average
/// daily budget must stay within it. Changed only by owners and admins.
model AdSpendLimit {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  currency            String   @db.Char(3)
  maxPlanBudgetMinor  BigInt   @map("max_plan_budget_minor")
  maxDailyBudgetMinor BigInt   @map("max_daily_budget_minor")
  updatedByUserId     String?  @map("updated_by_user_id") @db.Uuid
  version             Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, currency])
  @@index([updatedByUserId])
  @@map("ad_spend_limits")
}

/// A person the workspace may message on WhatsApp — only with their recorded opt-in. The
/// number is stored encrypted (token vault, bound to the workspace) and as a keyed hash
/// for lookups (inbound messages, opt-outs); only its last 4 digits are ever shown.
model WhatsAppContact {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  accountId             String    @map("account_id") @db.Uuid
  phoneHash             String    @map("phone_hash") @db.Char(64)
  phoneCiphertext       String    @map("phone_ciphertext")
  maskedNumber          String    @map("masked_number") @db.VarChar(20)
  /// OPTED_IN or OPTED_OUT.
  consentStatus         String    @map("consent_status") @db.VarChar(20)
  /// Where the opt-in was given (e.g. website_form, in_store, whatsapp_message).
  consentSource         String    @map("consent_source") @db.VarChar(40)
  consentAt             DateTime  @map("consent_at") @db.Timestamptz(3)
  optedOutAt            DateTime? @map("opted_out_at") @db.Timestamptz(3)
  /// The customer's last message to the business (opens the 24-hour service window).
  lastInboundAt         DateTime? @map("last_inbound_at") @db.Timestamptz(3)
  /// The customer stopped MARKETING messages (Meta user_preferences / error 131050);
  /// utility templates and service replies are still allowed. Cleared only by the
  /// customer (resume).
  marketingOptedOutAt   DateTime? @map("marketing_opted_out_at") @db.Timestamptz(3)
  marketingOptOutSource String?   @map("marketing_opt_out_source") @db.VarChar(40)
  addedByUserId         String?   @map("added_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account       AdAccount              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  addedBy       User?                  @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  messages      WhatsAppMessage[]
  consentEvents WhatsAppConsentEvent[]

  @@unique([workspaceId, accountId, phoneHash])
  @@index([accountId])
  @@index([addedByUserId])
  @@map("whatsapp_contacts")
}

/// One outbound WhatsApp message, sent only through an approved orchestration task. Its
/// lifecycle: PENDING → SENDING → ACCEPTED (Meta returned a message id) → SENT →
/// DELIVERED → READ, or FAILED; UNCERTAIN when the send may have happened without a
/// confirmation (never re-sent automatically). `idempotency_key` makes a repeated request
/// for the same message to the same contact return the existing one.
model WhatsAppMessage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  contactId         String    @map("contact_id") @db.Uuid
  phoneNumberId     String    @map("phone_number_id") @db.VarChar(64)
  /// TEMPLATE or TEXT.
  kind              String    @db.VarChar(20)
  templateName      String?   @map("template_name") @db.VarChar(512)
  templateLanguage  String?   @map("template_language") @db.VarChar(20)
  /// Template body parameters or the free-form text (business-authored).
  content           Json
  status            String    @db.VarChar(20)
  externalMessageId String?   @unique @map("external_message_id") @db.VarChar(128)
  errorCode         Int?      @map("error_code")
  idempotencyKey    String    @map("idempotency_key") @db.Char(64)
  runId             String?   @map("run_id") @db.Uuid
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  statusAt          DateTime? @map("status_at") @db.Timestamptz(3)
  /// An owner/admin looked at an UNCERTAIN message (checked the recipient's phone or
  /// WhatsApp Manager) and released the contact for further sends. Status stays UNCERTAIN.
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedByUserId  String?   @map("resolved_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     AdAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact     WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  run         AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  requestedBy User?           @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  resolvedBy  User?           @relation("WhatsAppMessageResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([accountId])
  @@index([contactId])
  @@index([runId])
  @@index([requestedByUserId])
  @@index([resolvedByUserId])
  @@map("whatsapp_messages")
}

/// Append-only consent history of a WhatsApp contact: every opt-in, opt-out, marketing
/// opt-out and marketing resume, with its source and time. Never updated or deleted.
model WhatsAppConsentEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  contactId   String   @map("contact_id") @db.Uuid
  /// OPTED_IN, OPTED_OUT, MARKETING_OPTED_OUT or MARKETING_RESUMED.
  kind        String   @db.VarChar(30)
  /// Where it came from: website_form, in_store, whatsapp_message, other (staff-recorded
  /// opt-in); staff; whatsapp_keyword; user_preferences; error_131050.
  source      String   @db.VarChar(40)
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  actor     User?           @relation("WhatsAppConsentActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, contactId, occurredAt(sort: Desc)])
  @@index([contactId])
  @@index([actorUserId])
  @@map("whatsapp_consent_events")
}

// ── Credits (Flexibx's own services; never the customer's advertising budget) ────
// A workspace pays for Flexibx's AI work in credits. The subscription allowance renews
// every period and expires at its end; purchased credits do not expire. Every paid task
// holds its price first (insufficient credits or a reached cap refuse it before any
// provider call), then captures it on success or releases it on failure. Every movement
// is an append-only ledger entry. Advertising spend is a separate thing (AdSpendLimit):
// it is paid by the customer to the platform and never touches credits.

enum CreditEntryKind {
  /// The period's subscription allowance was granted (renewal).
  SUBSCRIPTION_GRANT
  /// Unused subscription allowance expired at the end of its period.
  SUBSCRIPTION_EXPIRE
  /// Credits bought (manual invoice or a payment provider).
  PURCHASE
  /// Automatic top-up below the threshold, within the monthly ceiling.
  AUTO_RECHARGE
  /// Correction by a platform administrator (positive or negative).
  ADJUSTMENT
  /// A task's price set aside before it runs.
  HOLD
  /// The part of a hold actually charged.
  CAPTURE
  /// The part of a hold given back (failure, cancellation, or less than held).
  RELEASE

  @@map("credit_entry_kind")
}

enum CreditHoldStatus {
  HELD
  CAPTURED
  RELEASED

  @@map("credit_hold_status")
}

enum CreditRechargeStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("credit_recharge_status")
}

/// One per workspace, created on first use with the default plan.
model CreditAccount {
  workspaceId           String   @id @map("workspace_id") @db.Uuid
  /// Plan code (src/server/billing/plans.ts); changed by a platform administrator.
  planCode              String   @map("plan_code") @db.VarChar(40)
  periodStart           DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd             DateTime @map("period_end") @db.Timestamptz(3)
  /// Remaining subscription allowance of the current period (expires at its end).
  subscriptionCredits   Int      @map("subscription_credits")
  /// Purchased credits (never expire).
  purchasedCredits      Int      @map("purchased_credits")
  /// Credits set aside by running tasks (already taken from the two balances above).
  heldCredits           Int      @default(0) @map("held_credits")
  /// Spending caps the workspace sets for itself (null = none): credits per day (in the
  /// workspace time zone), per period, and per feature per period.
  dailyCap              Int?     @map("daily_cap")
  periodCap             Int?     @map("period_cap")
  featureCaps           Json     @default("{}") @map("feature_caps")
  /// Optional automatic top-up: when the balance falls below the threshold, buy
  /// `autoRechargeAmount`, never more than `autoRechargePeriodMax` credits per period.
  autoRechargeEnabled   Boolean  @default(false) @map("auto_recharge_enabled")
  autoRechargeThreshold Int?     @map("auto_recharge_threshold")
  autoRechargeAmount    Int?     @map("auto_recharge_amount")
  autoRechargePeriodMax Int?     @map("auto_recharge_period_max")
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid
  version               Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("credit_accounts")
}

/// A task's price set aside before it runs; settled once (captured or released).
model CreditHold {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String           @map("workspace_id") @db.Uuid
  /// Priced feature (src/server/billing/prices.ts), e.g. ai_text, ad_plan, social_reply.
  feature             String           @db.VarChar(40)
  amount              Int
  /// How the hold was taken from the balances (given back the same way).
  subscriptionPortion Int              @map("subscription_portion")
  purchasedPortion    Int              @map("purchased_portion")
  status              CreditHoldStatus @default(HELD)
  capturedAmount      Int?             @map("captured_amount")
  /// One hold per task attempt: a retry with the same key never holds twice.
  idempotencyKey      String           @map("idempotency_key") @db.VarChar(160)
  /// What the hold pays for (e.g. ai_generation:<id>).
  reference           String?          @db.VarChar(160)
  priceVersion        String           @map("price_version") @db.VarChar(40)
  userId              String?          @map("user_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt           DateTime?        @map("settled_at") @db.Timestamptz(3)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   CreditLedgerEntry[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@map("credit_holds")
}

/// Append-only: every credit movement with the balances after it.
model CreditLedgerEntry {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Strictly increasing order of entries (several share a timestamp in one transaction).
  sequence           BigInt          @unique @default(autoincrement())
  workspaceId        String          @map("workspace_id") @db.Uuid
  kind               CreditEntryKind
  /// Signed change of the available balance (subscription + purchased).
  amount             Int
  subscriptionAfter  Int             @map("subscription_after")
  purchasedAfter     Int             @map("purchased_after")
  heldAfter          Int             @map("held_after")
  holdId             String?         @map("hold_id") @db.Uuid
  feature            String?         @db.VarChar(40)
  /// AI provider and model of a captured task, and its cost to Flexibx when the
  /// provider's price is configured (null = unknown, never estimated).
  provider           String?         @db.VarChar(40)
  model              String?         @db.VarChar(120)
  providerCostMicros BigInt?         @map("provider_cost_micros")
  actorUserId        String?         @map("actor_user_id") @db.Uuid
  /// Invoice or payment reference, or an administrator's note.
  externalRef        String?         @map("external_ref") @db.VarChar(160)
  /// One manual grant per submitted form: a resubmission with the same key changes nothing.
  requestKey         String?         @map("request_key") @db.VarChar(80)
  note               String?         @db.VarChar(300)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hold      CreditHold? @relation(fields: [holdId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, requestKey])
  @@index([workspaceId, sequence(sort: Desc)])
  @@index([holdId])
  @@map("credit_ledger_entries")
}

/// An automatic top-up attempt (charged through the payment provider, once per key).
model CreditRecharge {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  amount         Int
  status         CreditRechargeStatus @default(PENDING)
  idempotencyKey String               @map("idempotency_key") @db.VarChar(160)
  provider       String?              @db.VarChar(40)
  externalRef    String?              @map("external_ref") @db.VarChar(160)
  failureCode    String?              @map("failure_code") @db.VarChar(60)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt      DateTime?            @map("settled_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@map("credit_recharges")
}

// ── AI Social Manager ─────────────────────────────────────────────────────────────
// AI agents that answer a business's Facebook Page and Instagram comments and messages.
// An agent works from the business's own knowledge (information, FAQ, policies, tone),
// drafts a reply for every new interaction (paid in credits), and either waits for a
// person (SUGGEST) or, in AUTO mode, sends low-risk replies itself within the limits the
// workspace set. Every human decision teaches it: edits and approvals become examples,
// rejections become rules, and a periodic self-review proposes better guidance that a
// person applies. Page access tokens are never stored: each send fetches the Page's
// token from the workspace's Meta connection right before the call.

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM

  @@map("social_platform")
}

enum SocialAgentMode {
  /// Every reply waits for a person.
  SUGGEST
  /// Low-risk replies are sent automatically within the agent's limits; others wait.
  AUTO

  @@map("social_agent_mode")
}

enum SocialInteractionKind {
  COMMENT
  MESSAGE

  @@map("social_interaction_kind")
}

enum SocialInteractionStatus {
  /// Received; no draft yet (drafting runs right after, or on the next tick).
  NEW
  /// A draft is ready and waits for a person.
  AWAITING_REVIEW
  /// The agent says a person must handle it (complaint, sensitive, out of scope).
  ESCALATED
  /// A reply is being sent.
  SENDING
  REPLIED
  /// The send may or may not have reached the platform: check before retrying.
  UNCERTAIN
  /// Drafting or sending failed (see lastError); a person can retry.
  FAILED
  /// A person chose not to reply.
  IGNORED

  @@map("social_interaction_status")
}

enum SocialReplyDecision {
  PENDING
  APPROVED
  EDITED
  REJECTED
  /// Sent automatically by an AUTO agent.
  AUTO

  @@map("social_reply_decision")
}

enum SocialLessonKind {
  /// A worked example (customer message → the reply a person approved or wrote).
  EXAMPLE
  /// A rule from a rejection ("never promise delivery dates").
  RULE
  /// A proposed rewrite of the agent's guidance from its self-review.
  GUIDANCE

  @@map("social_lesson_kind")
}

enum SocialLessonStatus {
  ACTIVE
  PROPOSED
  APPLIED
  DISMISSED

  @@map("social_lesson_status")
}

/// A Facebook Page or Instagram professional account the workspace manages here.
model SocialChannel {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  platform    SocialPlatform
  /// Page id (Facebook) or Instagram professional account id.
  externalId  String         @map("external_id") @db.VarChar(64)
  /// The Facebook Page an Instagram account belongs to (its token is the Page's).
  pageId      String         @map("page_id") @db.VarChar(64)
  name        String         @db.VarChar(200)
  /// The agent answering this channel (null = none; interactions are only collected).
  agentId     String?        @map("agent_id") @db.Uuid
  /// Meta webhook subscription done for this Page (subscribed_apps).
  subscribed  Boolean        @default(false)
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent        SocialAgent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  interactions SocialInteraction[]
  posts        SocialPost[]

  @@unique([workspaceId, platform, externalId])
  @@index([platform, externalId])
  @@index([agentId])
  @@map("social_channels")
}

/// An AI agent with its own knowledge, voice and limits.
model SocialAgent {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  name            String          @db.VarChar(120)
  /// customer_service, sales or community (shapes the instructions).
  role            String          @db.VarChar(40)
  active          Boolean         @default(false)
  mode            SocialAgentMode @default(SUGGEST)
  /// auto (the customer's language), ar or en.
  language        String          @default("auto") @db.VarChar(8)
  tone            String          @default("") @db.VarChar(500)
  businessInfo    String          @default("") @map("business_info") @db.VarChar(6000)
  /// [{ "q": "...", "a": "..." }], at most 30.
  faq             Json            @default("[]")
  policies        String          @default("") @db.VarChar(4000)
  escalation      String          @default("") @db.VarChar(2000)
  forbidden       String          @default("") @db.VarChar(2000)
  /// Guidance the agent works by; improved over time by applied self-review proposals.
  guidance        String          @default("") @db.VarChar(6000)
  guidanceVersion Int             @default(0) @map("guidance_version")
  /// AUTO mode only: categories that may be answered without a person, the minimum
  /// confidence, and the most automatic replies per day.
  autoCategories  String[]        @default([]) @map("auto_categories")
  minConfidence   Int             @default(85) @map("min_confidence")
  dailyAutoCap    Int             @default(50) @map("daily_auto_cap")
  /// The member whose authority the agent acts with when no person is present (set when
  /// it is activated; re-checked before every draft and send).
  delegateUserId  String?         @map("delegate_user_id") @db.Uuid
  version         Int             @default(0)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels     SocialChannel[]
  interactions SocialInteraction[]
  replies      SocialReply[]
  lessons      SocialLesson[]

  @@index([workspaceId])
  @@map("social_agents")
}

/// A comment or message received on a channel (the inbox).
/// One automatic reply per platform message across every workspace that manages the Page:
/// when two workspaces connect the same Page (an agency and its client) and both run AUTO
/// agents, only the first to claim a comment or message may answer it automatically; the
/// other leaves its draft for a person. The key is the platform's own ids, so a claim
/// reveals nothing about the other workspace (callers never read another workspace's row).
model SocialAutoReplyClaim {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  interactionId     String            @map("interaction_id") @db.Uuid
  platform          SocialPlatform
  channelExternalId String            @map("channel_external_id") @db.VarChar(64)
  externalId        String            @map("external_id") @db.VarChar(128)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  interaction       SocialInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@unique([platform, channelExternalId, externalId])
  @@index([workspaceId])
  @@index([interactionId])
  @@map("social_auto_reply_claims")
}

model SocialInteraction {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                  @map("workspace_id") @db.Uuid
  channelId        String                  @map("channel_id") @db.Uuid
  agentId          String?                 @map("agent_id") @db.Uuid
  kind             SocialInteractionKind
  /// Comment id or message id on the platform (deduplicates webhook redeliveries).
  externalId       String                  @map("external_id") @db.VarChar(128)
  /// The post (comments) or the sender (messages) the reply goes to.
  threadExternalId String                  @map("thread_external_id") @db.VarChar(128)
  authorExternalId String?                 @map("author_external_id") @db.VarChar(128)
  authorName       String?                 @map("author_name") @db.VarChar(200)
  text             String                  @db.VarChar(8000)
  receivedAt       DateTime                @map("received_at") @db.Timestamptz(3)
  status           SocialInteractionStatus @default(NEW)
  /// The agent's reading: question, complaint, praise, lead, spam or other.
  category         String?                 @db.VarChar(20)
  sentiment        String?                 @db.VarChar(20)
  lastError        String?                 @map("last_error") @db.VarChar(60)
  /// Drafting attempts (bounded; failures stay visible).
  draftAttempts    Int                     @default(0) @map("draft_attempts")
  /// A drafting attempt holds the message until then (see DRAFT_LEASE_MS).
  draftingUntil    DateTime?               @map("drafting_until") @db.Timestamptz(3)
  version          Int                     @default(0)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel         SocialChannel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  agent           SocialAgent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  replies         SocialReply[]
  autoReplyClaims SocialAutoReplyClaim[]

  @@unique([workspaceId, channelId, externalId])
  @@index([workspaceId, status, receivedAt(sort: Desc)])
  @@index([channelId])
  @@index([agentId])
  @@map("social_interactions")
}

/// A reply drafted by an agent, the decision on it, and its delivery.
model SocialReply {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String              @map("workspace_id") @db.Uuid
  interactionId   String              @map("interaction_id") @db.Uuid
  agentId         String              @map("agent_id") @db.Uuid
  generationId    String?             @map("generation_id") @db.Uuid
  draftText       String?             @map("draft_text") @db.VarChar(2000)
  confidence      Int
  needsHuman      Boolean             @map("needs_human")
  reason          String              @db.VarChar(500)
  guidanceVersion Int                 @map("guidance_version")
  decision        SocialReplyDecision @default(PENDING)
  /// The text actually sent (the draft, or a person's edit).
  finalText       String?             @map("final_text") @db.VarChar(2000)
  decidedByUserId String?             @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?           @map("decided_at") @db.Timestamptz(3)
  rejectReason    String?             @map("reject_reason") @db.VarChar(500)
  /// NOT_SENT, SENDING, SENT, UNCERTAIN or FAILED.
  sendStatus      String              @default("NOT_SENT") @map("send_status") @db.VarChar(20)
  externalReplyId String?             @map("external_reply_id") @db.VarChar(128)
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(3)
  sendError       String?             @map("send_error") @db.VarChar(60)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  interaction SocialInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  agent       SocialAgent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([interactionId])
  @@index([agentId, createdAt(sort: Desc)])
  @@map("social_replies")
}

/// What an agent learned: examples, rules and guidance proposals.
model SocialLesson {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  agentId         String             @map("agent_id") @db.Uuid
  kind            SocialLessonKind
  status          SocialLessonStatus
  /// edit, approval, rejection, self_review or manual.
  source          String             @db.VarChar(20)
  customerText    String?            @map("customer_text") @db.VarChar(2000)
  draftText       String?            @map("draft_text") @db.VarChar(2000)
  /// The approved/edited reply (EXAMPLE), the rule (RULE) or the proposed guidance (GUIDANCE).
  content         String             @db.VarChar(6000)
  replyId         String?            @map("reply_id") @db.Uuid
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  decidedByUserId String?            @map("decided_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     SocialAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, kind, status, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@map("social_lessons")
}

/// An approved content item published to a Facebook Page at its time (text and link).
/// Queued only from APPROVED or SCHEDULED content (the approval gate stays); published
/// once (claim SCHEDULED → PUBLISHING); a lost answer is UNCERTAIN and is looked up on
/// the Page before anything is posted again.
model SocialPost {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  contentItemId     String    @map("content_item_id") @db.Uuid
  channelId         String    @map("channel_id") @db.Uuid
  /// SCHEDULED, PUBLISHING, PUBLISHED, UNCERTAIN, FAILED or CANCELLED.
  status            String    @default("SCHEDULED") @db.VarChar(20)
  scheduledAt       DateTime  @map("scheduled_at") @db.Timestamptz(3)
  /// The exact text and link that are (or were) published.
  message           String    @db.VarChar(10000)
  link              String?   @db.VarChar(2000)
  externalPostId    String?   @map("external_post_id") @db.VarChar(128)
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(3)
  errorCode         String?   @map("error_code") @db.VarChar(60)
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem ContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  channel     SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, channelId])
  @@index([status, scheduledAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([channelId])
  @@map("social_posts")
}

/// Operational monitoring (Phase C). Last run of each scheduled job, written by the job
/// itself (best effort: a failed write never fails the job). Read by
/// GET /api/internal/ops-status to detect a scheduler that stopped. Global/system table;
/// holds names, timestamps and phase names only — never customer data.
model SystemHeartbeat {
  /// Job name, e.g. `automation-tick`, `video-retention`.
  name            String    @id @db.VarChar(80)
  lastStartedAt   DateTime? @map("last_started_at") @db.Timestamptz(3)
  lastFinishedAt  DateTime? @map("last_finished_at") @db.Timestamptz(3)
  lastSucceededAt DateTime? @map("last_succeeded_at") @db.Timestamptz(3)
  /// `ok` | `failed` (of the last finished run).
  lastStatus      String?   @map("last_status") @db.VarChar(20)
  /// Names of the failed phases of the last run (empty when it succeeded).
  failedPhases    String[]  @default([]) @map("failed_phases")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_heartbeats")
}

/// When each alert key was last delivered, so a recurring problem alerts once per interval
/// across every process (web server, CLI runs). Global/system table; keys and counts only.
model AlertThrottle {
  key             String   @id @db.VarChar(120)
  lastSentAt      DateTime @map("last_sent_at") @db.Timestamptz(3)
  /// Occurrences swallowed since the last delivery (reported with the next one).
  suppressedCount Int      @default(0) @map("suppressed_count")

  @@map("alert_throttles")
}
