// Flexibx — database foundation (Phase 1)
//
// Conventions (see docs/ARCHITECTURE.md):
// - UUID primary keys generated by Postgres (gen_random_uuid()).
// - snake_case table/column names via @@map / @map.
// - Every workspace-owned table has a NOT NULL `workspace_id` FK with ON DELETE CASCADE,
//   and its indexes lead with `workspace_id`. Register such models in
//   src/server/db/tenant-guard.ts (TENANT_MODELS).
// - CHECK constraints and extensions live in raw SQL inside migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  BUSINESS
  AGENCY

  @@map("workspace_type")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  VIEWER
  CLIENT

  @@map("workspace_role")
}

enum Locale {
  ar
  en

  @@map("locale")
}

/// Platform user. Shape is compatible with Better Auth's core `user` model (Phase 2).
model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String   @unique @db.Citext
  emailVerified   Boolean  @default(false) @map("email_verified")
  name            String
  image           String?
  locale          Locale   @default(ar)
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships WorkspaceMember[]
  auditLogs   AuditLog[]

  @@map("users")
}

/// Tenant root. An AGENCY workspace may own client workspaces through `parentWorkspaceId`.
///
/// Deletion is SOFT: the application sets `deletedAt` and must exclude soft-deleted
/// workspaces from every lookup. Hard deletes are blocked while audit history exists
/// (AuditLog -> Workspace is ON DELETE RESTRICT). A future, controlled purge job may
/// permanently delete a workspace's data (e.g. retention or data-erasure requests);
/// it is intentionally not implemented yet.
model Workspace {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String        @db.VarChar(120)
  slug              String        @unique @db.Citext
  type              WorkspaceType @default(BUSINESS)
  parentWorkspaceId String?       @map("parent_workspace_id") @db.Uuid
  defaultLocale     Locale        @default(ar) @map("default_locale")
  timezone          String        @default("Asia/Riyadh") @db.VarChar(64)
  /// Soft-deletion timestamp. NULL = active.
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent    Workspace?        @relation("WorkspaceClients", fields: [parentWorkspaceId], references: [id], onDelete: Restrict)
  clients   Workspace[]       @relation("WorkspaceClients")
  members   WorkspaceMember[]
  auditLogs AuditLog[]

  @@index([parentWorkspaceId])
  @@map("workspaces")
}

/// Tenant-owned: membership of a user in a workspace with a role.
model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
  @@map("workspace_members")
}

/// Append-only audit trail. `workspaceId` is null for platform-level events.
/// Workspace deletion must never erase audit history, hence ON DELETE RESTRICT.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_logs")
}
