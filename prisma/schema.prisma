// Flexibx — database foundation (Phase 1)
//
// Conventions (see docs/ARCHITECTURE.md):
// - UUID primary keys generated by Postgres (gen_random_uuid()).
// - snake_case table/column names via @@map / @map.
// - Every workspace-owned table has a NOT NULL `workspace_id` FK with ON DELETE CASCADE,
//   and its indexes lead with `workspace_id`. Register such models in
//   src/server/db/tenant-guard.ts (TENANT_MODELS).
// - CHECK constraints and extensions live in raw SQL inside migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  BUSINESS
  AGENCY

  @@map("workspace_type")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  VIEWER
  CLIENT

  @@map("workspace_role")
}

enum Locale {
  ar
  en

  @@map("locale")
}

/// Platform user, also Better Auth's `user` model. `isPlatformAdmin` and `locale` are
/// never accepted from auth input (see src/server/auth/auth-config.ts).
model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String   @unique @db.Citext
  emailVerified   Boolean  @default(false) @map("email_verified")
  name            String
  image           String?
  locale          Locale   @default(ar)
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        WorkspaceMember[]
  auditLogs          AuditLog[]
  sessions           Session[]
  accounts           Account[]
  invitationsCreated WorkspaceInvitation[]
  contentCreated     ContentItem[]
  mediaUploaded      MediaAsset[]

  @@map("users")
}

/// Tenant root. An AGENCY workspace may own client workspaces through `parentWorkspaceId`.
///
/// Deletion is SOFT: the application sets `deletedAt` and must exclude soft-deleted
/// workspaces from every lookup. Hard deletes are blocked while audit history exists
/// (AuditLog -> Workspace is ON DELETE RESTRICT). A future, controlled purge job may
/// permanently delete a workspace's data (e.g. retention or data-erasure requests);
/// it is intentionally not implemented yet.
model Workspace {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String        @db.VarChar(120)
  slug              String        @unique @db.Citext
  type              WorkspaceType @default(BUSINESS)
  parentWorkspaceId String?       @map("parent_workspace_id") @db.Uuid
  defaultLocale     Locale        @default(ar) @map("default_locale")
  timezone          String        @default("Asia/Riyadh") @db.VarChar(64)
  /// Soft-deletion timestamp. NULL = active.
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent      Workspace?            @relation("WorkspaceClients", fields: [parentWorkspaceId], references: [id], onDelete: Restrict)
  clients     Workspace[]           @relation("WorkspaceClients")
  members     WorkspaceMember[]
  auditLogs   AuditLog[]
  invitations WorkspaceInvitation[]

  // Marketing Core (Phase 3). Changed only through their own guarded models.
  brand             Brand?
  audiences         Audience[]
  marketingGoals    MarketingGoal[]
  contentPillars    ContentPillar[]
  campaigns         Campaign[]
  campaignGoals     CampaignGoal[]
  campaignPillars   CampaignPillar[]
  contentItems      ContentItem[]
  mediaAssets       MediaAsset[]
  contentItemAssets ContentItemAsset[]

  @@index([parentWorkspaceId])
  @@map("workspaces")
}

/// Tenant-owned: membership of a user in a workspace with a role.
model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
  @@map("workspace_members")
}

/// Tenant-owned: an invitation to join a workspace with a role. Only the SHA-256 hash
/// of the one-time token is stored; the plaintext exists once, in the link shown to the
/// inviter. Pending = not accepted, not revoked (expiry is checked by the application).
/// Raw SQL in the migration adds: one pending invitation per (workspace, email), no
/// OWNER invitations, hex token hash, and "accepted XOR revoked or neither".
model WorkspaceInvitation {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  email           String        @db.Citext
  role            WorkspaceRole
  tokenHash       String        @unique @map("token_hash") @db.Char(64)
  invitedByUserId String?       @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?     @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([invitedByUserId])
  @@map("workspace_invitations")
}

/// Append-only audit trail. `workspaceId` is null for platform-level events.
/// Workspace deletion must never erase audit history, hence ON DELETE RESTRICT.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ── Authentication (Better Auth). Global/system tables: never workspace-scoped and
// only accessed by the auth layer through the system client (see tenant-guard.ts). ──

/// Database session. `token` is Better Auth's raw session token; the cookie carries
/// `token.HMAC(token, AUTH_SECRET)`, so a database copy alone cannot forge a cookie.
/// Application code must never read this table directly (enforced by the tenant guard
/// and a static test).
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Credentials per provider. For email/password, `providerId = "credential"` and
/// `password` holds the scrypt hash. OAuth columns are reserved (OAuth is not enabled).
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived verification values (email verification, password reset).
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Better Auth's rate-limit counters (`rateLimit.storage: "database"`). Global/system
/// table, only the auth layer touches it. `key` is `<client ip or fallback>|<path>`;
/// Flexibx-defined buckets put an HMAC of the email or user id in the path, never the
/// raw value. `lastRequest` is a millisecond timestamp.
model RateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@index([lastRequest])
  @@map("rate_limits")
}

// ── Marketing Core (Phase 3) ──────────────────────────────────────────────────
// Every model below is workspace-owned: a NOT NULL workspace_id, registered in the
// tenant guard, and every relation between two of them is checked by a database
// trigger to stay inside one workspace (see the migration). Platform-independent:
// nothing here knows about a social network.

enum BrandLanguage {
  AR
  EN
  BILINGUAL

  @@map("brand_language")
}

enum BuyingIntent {
  LOW
  MEDIUM
  HIGH

  @@map("buying_intent")
}

enum MarketingGoalType {
  AWARENESS
  ENGAGEMENT
  LEADS
  SALES
  RETENTION
  TRAFFIC
  GROWTH
  OTHER

  @@map("marketing_goal_type")
}

enum MarketingGoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ARCHIVED

  @@map("marketing_goal_status")
}

enum ContentPillarStatus {
  ACTIVE
  ARCHIVED

  @@map("content_pillar_status")
}

enum CampaignStatus {
  DRAFT
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED

  @@map("campaign_status")
}

enum ContentType {
  POST
  REEL
  STORY
  VIDEO
  CAROUSEL
  ARTICLE
  EMAIL
  OTHER

  @@map("content_type")
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED

  @@map("content_status")
}

/// One brand profile per workspace: the source the future AI Brand Brain will read.
model Brand {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String        @unique @map("workspace_id") @db.Uuid
  name             String        @db.VarChar(120)
  description      String?       @db.VarChar(2000)
  website          String?       @db.VarChar(2048)
  industry         String?       @db.VarChar(120)
  market           String?       @db.VarChar(200)
  language         BrandLanguage @default(AR)
  mission          String?       @db.VarChar(2000)
  positioning      String?       @db.VarChar(2000)
  valueProposition String?       @map("value_proposition") @db.VarChar(2000)
  toneOfVoice      String?       @map("tone_of_voice") @db.VarChar(1000)
  personality      String?       @db.VarChar(1000)
  keywords         String[]      @default([])
  forbiddenWords   String[]      @default([]) @map("forbidden_words")
  ctaStyle         String?       @map("cta_style") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("brands")
}

/// A marketing audience profile (not a CRM contact list).
model Audience {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  name              String        @db.VarChar(120)
  description       String?       @db.VarChar(2000)
  /// Free-form descriptive attributes: [{ "label": "...", "value": "..." }] (validated).
  attributes        Json          @default("[]")
  painPoints        String[]      @default([]) @map("pain_points")
  needs             String[]      @default([])
  interests         String[]      @default([])
  buyingIntent      BuyingIntent? @map("buying_intent")
  objections        String[]      @default([])
  preferredChannels String[]      @default([]) @map("preferred_channels")
  notes             String?       @db.VarChar(4000)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentPillars ContentPillar[]
  campaigns      Campaign[]
  contentItems   ContentItem[]

  @@index([workspaceId, name])
  @@map("audiences")
}

model MarketingGoal {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  type        MarketingGoalType
  title       String              @db.VarChar(160)
  description String?             @db.VarChar(2000)
  kpi         String?             @db.VarChar(160)
  target      Decimal?            @db.Decimal(14, 2)
  startDate   DateTime?           @map("start_date") @db.Date
  endDate     DateTime?           @map("end_date") @db.Date
  status      MarketingGoalStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignGoals CampaignGoal[]
  contentItems  ContentItem[]

  @@index([workspaceId, status])
  @@map("marketing_goals")
}

model ContentPillar {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  name        String              @db.VarChar(120)
  description String?             @db.VarChar(2000)
  objective   String?             @db.VarChar(1000)
  audienceId  String?             @map("audience_id") @db.Uuid
  status      ContentPillarStatus @default(ACTIVE)
  /// Ordering inside the workspace (lower first).
  position    Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  audience        Audience?        @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  campaignPillars CampaignPillar[]
  contentItems    ContentItem[]

  @@index([workspaceId, status, position])
  @@index([audienceId])
  @@map("content_pillars")
}

model Campaign {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String         @map("workspace_id") @db.Uuid
  name              String         @db.VarChar(160)
  description       String?        @db.VarChar(2000)
  objective         String?        @db.VarChar(1000)
  startDate         DateTime?      @map("start_date") @db.Date
  endDate           DateTime?      @map("end_date") @db.Date
  status            CampaignStatus @default(DRAFT)
  audienceId        String?        @map("audience_id") @db.Uuid
  /// Planning metadata only (minor units + ISO 4217); no ad platform, no billing.
  budgetAmountMinor BigInt?        @map("budget_amount_minor")
  budgetCurrency    String?        @map("budget_currency") @db.Char(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  audience     Audience?        @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  goals        CampaignGoal[]
  pillars      CampaignPillar[]
  contentItems ContentItem[]

  @@index([workspaceId, status, startDate])
  @@index([audienceId])
  @@map("campaigns")
}

model CampaignGoal {
  workspaceId String   @map("workspace_id") @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  goalId      String   @map("goal_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  goal      MarketingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([campaignId, goalId])
  @@index([workspaceId])
  @@index([goalId])
  @@map("campaign_goals")
}

model CampaignPillar {
  workspaceId String   @map("workspace_id") @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  pillarId    String   @map("pillar_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pillar    ContentPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@id([campaignId, pillarId])
  @@index([workspaceId])
  @@index([pillarId])
  @@map("campaign_pillars")
}

/// A platform-independent piece of marketing content and its workflow state.
model ContentItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  title           String        @db.VarChar(200)
  body            String        @default("") @db.VarChar(10000)
  type            ContentType   @default(POST)
  status          ContentStatus @default(DRAFT)
  campaignId      String?       @map("campaign_id") @db.Uuid
  pillarId        String?       @map("pillar_id") @db.Uuid
  audienceId      String?       @map("audience_id") @db.Uuid
  goalId          String?       @map("goal_id") @db.Uuid
  /// Planned time while a draft; the committed time once SCHEDULED.
  scheduledAt     DateTime?     @map("scheduled_at") @db.Timestamptz(3)
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(3)
  notes           String?       @db.VarChar(4000)
  metadata        Json          @default("{}")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pillar    ContentPillar?     @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  audience  Audience?          @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  goal      MarketingGoal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdBy User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  assets    ContentItemAsset[]

  @@index([workspaceId, status, updatedAt(sort: Desc)])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([campaignId])
  @@index([pillarId])
  @@index([audienceId])
  @@index([goalId])
  @@index([createdByUserId])
  @@map("content_items")
}

/// An uploaded file. Bytes live in object storage under a server-generated key.
model MediaAsset {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  /// Display name only (sanitized); never used for storage paths.
  filename         String   @db.VarChar(255)
  contentType      String   @map("content_type") @db.VarChar(100)
  sizeBytes        Int      @map("size_bytes")
  storageKey       String   @unique @map("storage_key") @db.VarChar(512)
  width            Int?
  height           Int?
  altText          String?  @map("alt_text") @db.VarChar(500)
  metadata         Json     @default("{}")
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User?              @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  contentLinks ContentItemAsset[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([uploadedByUserId])
  @@map("media_assets")
}

model ContentItemAsset {
  workspaceId   String   @map("workspace_id") @db.Uuid
  contentItemId String   @map("content_item_id") @db.Uuid
  mediaAssetId  String   @map("media_asset_id") @db.Uuid
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([contentItemId, mediaAssetId])
  @@index([workspaceId])
  @@index([mediaAssetId])
  @@map("content_item_assets")
}
